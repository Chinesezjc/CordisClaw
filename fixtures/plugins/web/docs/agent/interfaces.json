{
  "plugin_id": "web",
  "plugin_path": "web",
  "plugin_version": "0.1.0",
  "abi_version": 2,
  "command_name": null,
  "nodes": [
    {
      "id": "web_search",
      "summary": "Search the web. Returns ranked results with title, URL, date and a summary written for a model to read. Use it to check a fact instead of answering from memory; follow up with web_fetch for a full page.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "query"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "web_search"
          },
          "query": {
            "type": "string",
            "description": "Search query"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Structured search results (numbered list with titles + URLs) + AI summary"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "makes a POST to the DeepSeek Search API"
      ],
      "failure_modes": [
        "api key not configured",
        "network unavailable",
        "rate limited"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "web_fetch",
      "summary": "Read one web page. Uses the DeepSeek Fetch API (clean Markdown, max 8000 chars) and falls back to a local fetch. Only http/https allowed; private addresses are refused.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "url"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "web_fetch"
          },
          "url": {
            "type": "string",
            "description": "URL to fetch"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "makes a POST to the DeepSeek Fetch API, then an HTTP GET if it refuses"
      ],
      "failure_modes": [
        "invalid URL",
        "network timeout",
        "localhost/private IP blocked"
      ],
      "node_type": "router",
      "agent_accessible": true
    }
  ],
  "system_hint": null
}
