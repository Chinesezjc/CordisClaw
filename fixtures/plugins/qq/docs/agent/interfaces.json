{
  "plugin_id": "qq",
  "plugin_path": "qq",
  "plugin_version": "0.1.0",
  "abi_version": 2,
  "command_name": "Qq",
  "nodes": [
    {
      "id": "qq_entry",
      "summary": "QQ adapter using the NoneBot (OneBot v11) protocol. Connect to a OneBot-compatible QQ client for sending messages. Actions: configure, send, status, call, block, unblock, allow, disallow.",
      "input_schema": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "configure | send | status | call | block | unblock | allow | disallow"
          },
          "url": {
            "type": "string",
            "description": "OneBot HTTP API base URL (for configure)"
          },
          "target": {
            "type": "string",
            "description": "group:<id> or private:<id>"
          },
          "message": {
            "type": "string",
            "description": "Message text (for send)"
          },
          "payload": {
            "type": "object",
            "description": "Raw API call payload (for call)"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {}
        }
      },
      "side_effects": [
        "requires OneBot HTTP server running"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "invalid target format",
        "message is empty",
        "OneBot API error",
        "unsupported action"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_serve",
      "summary": "Start an HTTP server to receive OneBot v11 message events. Configure your OneBot client to POST events to http://<host>:<port>/onebot/event. Supports grayscale group whitelist.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_serve"
          },
          "payload": {
            "type": "object",
            "properties": {
              "port": {
                "type": "integer",
                "description": "HTTP listen port (default 8080)"
              },
              "onebot_url": {
                "type": "string",
                "description": "OneBot HTTP API URL"
              },
              "allow_groups": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Group whitelist for grayscale testing"
              }
            }
          },
          "agent_session_id": {
            "type": "string",
            "description": "Optional: agent session ID for message routing"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "starts an HTTP server thread",
        "listens on configured port"
      ],
      "failure_modes": [
        "port already in use",
        "OneBot client not configured to POST events"
      ],
      "node_type": "task",
      "agent_accessible": true
    },
    {
      "id": "qq_ws_serve",
      "summary": "Start a WebSocket server to receive OneBot v11 message events via reverse WS connection. Configure your OneBot client (e.g. Napcat) to connect as a WebSocket client to ws://<host>:<port>/. Supports the same grayscale group whitelist as qq_serve.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_ws_serve"
          },
          "action": {
            "type": "string",
            "description": "Set to \"stop\" to shut down the WebSocket server and release the port"
          },
          "payload": {
            "type": "object",
            "properties": {
              "port": {
                "type": "integer",
                "description": "WebSocket listen port (default 8002)"
              }
            }
          },
          "agent_session_id": {
            "type": "string",
            "description": "Optional: agent session ID for message routing"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "starts a WebSocket server thread",
        "listens on configured port for OneBot WS client connections"
      ],
      "failure_modes": [
        "port already in use",
        "OneBot WS client not configured to connect"
      ],
      "node_type": "task",
      "agent_accessible": false
    },
    {
      "id": "qq_fetch_messages",
      "summary": "Fetch queued incoming QQ messages received by qq_serve. Returns all messages and drains the queue. Agent should poll this periodically.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_fetch_messages"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "drains the message queue"
      ],
      "failure_modes": [],
      "node_type": "router",
      "agent_accessible": false
    },
    {
      "id": "qq_send",
      "summary": "Send a message to a QQ group or private chat via OneBot v11 HTTP API. Supports reply/quote via reply_to.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "target",
          "message"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_send"
          },
          "target": {
            "type": "string",
            "description": "group:<id> or private:<id>"
          },
          "message": {
            "type": "string",
            "description": "Message text to send"
          },
          "reply_to": {
            "type": "integer",
            "description": "Optional message_id to reply/quote"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "sends HTTP request to OneBot API"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "invalid target format",
        "message is empty"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_group_info",
      "summary": "Get a group's name and size (member_count / max_member_count) — use it to tell a two-person group from a busy one. Returns the raw OneBot response, so the fields sit at data.data.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "target"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_group_info"
          },
          "target": {
            "type": "string",
            "description": "group:<id>"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "object",
            "description": "Raw OneBot get_group_info response",
            "properties": {
              "status": {
                "type": "string"
              },
              "retcode": {
                "type": "integer"
              },
              "data": {
                "type": "object",
                "properties": {
                  "group_id": {
                    "type": "integer"
                  },
                  "group_name": {
                    "type": "string"
                  },
                  "member_count": {
                    "type": "integer"
                  },
                  "max_member_count": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "calls OneBot get_group_info API"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "invalid target format",
        "group not found"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_group_members",
      "summary": "Get the raw OneBot member list for a group (get_group_member_list). Each entry carries user_id, nickname, card and role (owner/admin/member).",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "target"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_group_members"
          },
          "target": {
            "type": "string",
            "description": "group:<id>"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "object",
            "description": "Raw OneBot get_group_member_list response"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "calls OneBot get_group_member_list API"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "target must be group:<id>"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_group_roles",
      "summary": "Answer 'who is the group owner / who are the admins?'. Aggregates get_group_member_list by role, and falls back to get_group_info_ex (data.extInfo.groupOwnerId.memberUin) when the member list has no role field. source tells you which path was used.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "target"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_group_roles"
          },
          "target": {
            "type": "string",
            "description": "group:<id>"
          },
          "payload": {
            "type": "object",
            "properties": {
              "onebot_url": {
                "type": "string",
                "description": "Optional OneBot HTTP API URL override (defaults to STATE / runtime config)"
              },
              "access_token": {
                "type": "string",
                "description": "Optional OneBot access token override (defaults to STATE / runtime config)"
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "owner": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "{user_id, nickname, card} or null"
              },
              "admins": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "member_count": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "source": {
                "type": "string",
                "description": "member_list | group_info_ex"
              }
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "calls OneBot get_group_member_list, then get_group_info_ex when the owner is missing"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "invalid target format",
        "OneBot API error"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_reply_policy",
      "summary": "Read the reply policy that is EFFECTIVE for a group (omit `group` to read the shared default). Returns the mode (quiet | balanced | chatty | one_on_one), the policy text actually shipped to the model, and where it came from (group | default | builtin).",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_reply_policy"
          },
          "group": {
            "type": "string",
            "description": "QQ group id; omit for the shared default"
          },
          "data_dir": {
            "type": "string",
            "description": "Optional data directory override"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "group": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mode": {
                "type": "string"
              },
              "policy": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "description": "group | default | builtin"
              },
              "is_default": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "side_effects": [
        "reads data/qq_reply_policies.json"
      ],
      "failure_modes": [],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_set_reply_policy",
      "summary": "Persist the reply policy for ONE group (or the shared default when `group` is omitted). Two ways to set it: `mode` picks a preset (quiet = only when named/@; balanced = judge by context; chatty = join in actively; one_on_one = treat as a direct chat), `policy` overrides the preset with free text. Takes effect on the NEXT message — no rebuild, no restart.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_set_reply_policy"
          },
          "group": {
            "type": "string",
            "description": "QQ group id; omit to change the shared default"
          },
          "mode": {
            "type": "string",
            "enum": [
              "quiet",
              "balanced",
              "chatty",
              "one_on_one"
            ]
          },
          "policy": {
            "type": "string",
            "description": "Optional free-text override (English; shown verbatim)"
          },
          "data_dir": {
            "type": "string",
            "description": "Optional data directory override"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      },
      "side_effects": [
        "writes data/qq_reply_policies.json"
      ],
      "failure_modes": [
        "mode or policy is required",
        "unknown mode"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_group_memory",
      "summary": "Read the memo you wrote about this group: how talkative it wants you, its standing topics, what it already rejected. memory=null means you have not written anything for this group yet.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "group"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_group_memory"
          },
          "group": {
            "type": "string",
            "description": "QQ group id"
          },
          "data_dir": {
            "type": "string",
            "description": "Optional data directory override"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "memory": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "updated_at_ms": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "updated_by": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "side_effects": [
        "reads data/qq_group_memory.json"
      ],
      "failure_modes": [
        "group is required for qq_get_group_memory"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_set_group_memory",
      "summary": "Write the memo about a group, in your own words: does it want you talkative or quiet, what it talks about, what you already tried and got told off for. The memo is not injected into your context — read it with `qq_get_group_memory` when you need it. Write only what is DURABLE (not something you read from one message). Blank `memory` deletes the entry. There is no length cap.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "group"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_set_group_memory"
          },
          "group": {
            "type": "string",
            "description": "QQ group id"
          },
          "memory": {
            "type": "string",
            "description": "Memo text; empty string deletes it"
          },
          "data_dir": {
            "type": "string",
            "description": "Optional data directory override"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "memory": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      },
      "side_effects": [
        "writes data/qq_group_memory.json"
      ],
      "failure_modes": [
        "group is required for qq_set_group_memory"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_system_notify",
      "summary": "Kernel notification handler — receives system messages and forwards to configured test groups.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "message"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_system_notify"
          },
          "message": {
            "type": "string",
            "description": "Notification text"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "sends QQ message to all configured test_groups"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "no test_groups configured"
      ],
      "node_type": "router",
      "agent_accessible": false
    }
  ],
  "system_hint": "你在这个 QQ 群里是一个普通成员，不是客服。像群里的人一样自然聊天。\n说话方式：短，一两句；用群里的口吻；不要列点、不要总结、不要客服腔；一次只发一条。\n不要自称 AI、机器人、助手，也不要提模型、服务器、提示词这类设定；别人问你是不是机器人，就当玩笑接过去。\n什么时候说：有人 @ 你、问你、或明确在说你这才是找你，回；别人互相聊、斗图、互怼，就待着别接，也不要用问句搭话。\n别抬杠：回复里尽量不用问句，真需要信息才问一下。别人说你话多、嘴欠、让你闭嘴，那多半是对的——回一句短的认下来（比如「行，我少说」）就够了，然后接下来几条消息都别再开口。不辩解、不反问、不嘲讽回去。\n不想说话就只输出 {\"action\":\"suspend\"}，它不会显示给群里。\n发言必须走工具：invoke_plugin(qq, qq_send, {\"node_id\":\"qq_send\",\"target\":\"<reply_target>\",\"message\":\"<你要说的话>\"})，然后输出 {\"action\":\"suspend\"}。最终输出只能是这个 JSON，正文只放在 message 里。\n引用某条消息：把它的 msg=<id> 作为 \"reply_to\":\"<id>\" 一起传；@某人写 [CQ:at,qq=<uid>]；发图写 [CQ:image,file=<url>]。\n你的 QQ 号是 {setting:bot_uin}；@[id=...] 里的数字等于它才是 @ 你，纯文本 @ 不算。\n群记忆：需要时用 qq_get_group_memory / qq_set_group_memory 读写，不确定就别写。\n不确定的事别编：没调用过的工具、没看到的消息，都不要说成真的。"
}
