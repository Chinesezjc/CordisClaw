{
  "plugin_id": "qq",
  "plugin_path": "qq",
  "plugin_version": "0.1.0",
  "abi_version": 2,
  "command_name": "Qq",
  "nodes": [
    {
      "id": "qq_entry",
      "summary": "QQ adapter using the NoneBot (OneBot v11) protocol. Connect to a OneBot-compatible QQ client for sending messages. Actions: configure, send, status, call, block, unblock, allow, disallow.",
      "input_schema": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "configure | send | status | call | block | unblock | allow | disallow"
          },
          "url": {
            "type": "string",
            "description": "OneBot HTTP API base URL (for configure)"
          },
          "target": {
            "type": "string",
            "description": "group:<id> or private:<id>"
          },
          "message": {
            "type": "string",
            "description": "Message text (for send)"
          },
          "payload": {
            "type": "object",
            "description": "Raw API call payload (for call)"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {}
        }
      },
      "side_effects": [
        "requires OneBot HTTP server running"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "invalid target format",
        "message is empty",
        "OneBot API error",
        "unsupported action"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_serve",
      "summary": "Start the HTTP server that receives OneBot v11 events (POST http://<host>:<port>/onebot/event) and the message poller that hands them to the agent. `action: \"stop\"` stops both and releases the port.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_serve"
          },
          "action": {
            "type": "string",
            "description": "Set to \"stop\" to shut down the HTTP server and the message poller"
          },
          "payload": {
            "type": "object",
            "properties": {
              "port": {
                "type": "integer",
                "description": "HTTP listen port (default 8080)"
              },
              "onebot_url": {
                "type": "string",
                "description": "OneBot HTTP API base URL"
              },
              "access_token": {
                "type": "string",
                "description": "OneBot access token (also used to verify X-Signature)"
              },
              "allow_groups": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Group whitelist (empty = all groups)"
              },
              "block_groups": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Group blacklist (wins over allow_groups; falls back to the persisted list)"
              }
            }
          },
          "agent_session_id": {
            "type": "string",
            "description": "Optional: agent session ID for message routing"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "binds the HTTP port and starts the event loop thread",
        "starts the message poller that drains MESSAGE_QUEUE into agent_trigger",
        "stop joins both threads before the dylib is unloaded"
      ],
      "failure_modes": [
        "port already in use",
        "OneBot client not configured to POST events"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_ws_serve",
      "summary": "Start the WebSocket server for the OneBot v11 reverse-WS connection (Napcat connects to ws://<host>:<port>/) and the message poller. WS frames go through the same dedup / whitelist / envelope path as qq_serve. `action: \"stop\"` stops it and releases the port; a repeated start is idempotent.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_ws_serve"
          },
          "action": {
            "type": "string",
            "description": "Set to \"stop\" to shut down the WebSocket server and release the port"
          },
          "payload": {
            "type": "object",
            "properties": {
              "port": {
                "type": "integer",
                "description": "WebSocket listen port (default 8002)"
              }
            }
          },
          "agent_session_id": {
            "type": "string",
            "description": "Optional: agent session ID for message routing"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "binds the WS port and starts the accept thread",
        "starts the message poller that drains MESSAGE_QUEUE into agent_trigger",
        "stop joins the accept thread and the poller before the dylib is unloaded"
      ],
      "failure_modes": [
        "port already in use",
        "OneBot WS client not configured to connect"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_fetch_messages",
      "summary": "Fetch queued incoming QQ messages received by qq_serve. Returns all messages and drains the queue. Agent should poll this periodically.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_fetch_messages"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "drains the message queue"
      ],
      "failure_modes": [],
      "node_type": "router",
      "agent_accessible": false
    },
    {
      "id": "qq_send",
      "summary": "Send a message to a QQ group or private chat via OneBot v11 HTTP API. Supports reply/quote via reply_to.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "target",
          "message"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_send"
          },
          "target": {
            "type": "string",
            "description": "group:<id> or private:<id>"
          },
          "message": {
            "type": "string",
            "description": "Message text to send"
          },
          "reply_to": {
            "type": "integer",
            "description": "Optional message_id to reply/quote"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "sends HTTP request to OneBot API"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "invalid target format",
        "message is empty",
        "read-only channel: reply policy is disabled for group <id>; you can read but must not send",
        "muted in group <id> until <HH:MM> (N minutes left)"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_group_requests",
      "summary": "List, approve or reject OneBot v11 GROUP requests (`sub_type: add` = 加群申请, `invite` = 邀请入群). `action: \"list\"` (default) returns what is waiting with `flag`, `sub_type`, `group_id`, `user_id`, `comment`, `time_ms`; `approve` / `reject` answers ONE request by `flag` via set_group_add_request and drops it from the queue. Only the 32 most recent are kept; list first, then answer.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_group_requests"
          },
          "action": {
            "type": "string",
            "enum": [
              "list",
              "approve",
              "reject"
            ],
            "description": "list (default) | approve | reject"
          },
          "flag": {
            "type": "string",
            "description": "Request flag taken from action=list (required for approve / reject)"
          },
          "reason": {
            "type": "string",
            "description": "Optional refusal note (reject only)"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "description": "How many requests are waiting"
              },
              "requests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "flag": {
                      "type": "string"
                    },
                    "sub_type": {
                      "type": "string",
                      "description": "add | invite"
                    },
                    "group_id": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "user_id": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "comment": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "time_ms": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "calls OneBot set_group_add_request on approve / reject",
        "drops an answered request from the queue"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "unknown action",
        "flag is required to approve a group request",
        "no pending group request with flag '<flag>'",
        "OneBot API error"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_group_info",
      "summary": "Get a group's name and size (member_count / max_member_count) — use it to tell a two-person group from a busy one. Returns the raw OneBot response, so the fields sit at data.data.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "target"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_group_info"
          },
          "target": {
            "type": "string",
            "description": "group:<id>"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "object",
            "description": "Raw OneBot get_group_info response",
            "properties": {
              "status": {
                "type": "string"
              },
              "retcode": {
                "type": "integer"
              },
              "data": {
                "type": "object",
                "properties": {
                  "group_id": {
                    "type": "integer"
                  },
                  "group_name": {
                    "type": "string"
                  },
                  "member_count": {
                    "type": "integer"
                  },
                  "max_member_count": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "calls OneBot get_group_info API"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "invalid target format",
        "group not found"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_group_members",
      "summary": "Get the raw OneBot member list for a group (get_group_member_list). Each entry carries user_id, nickname, card and role (owner/admin/member).",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "target"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_group_members"
          },
          "target": {
            "type": "string",
            "description": "group:<id>"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "object",
            "description": "Raw OneBot get_group_member_list response"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "calls OneBot get_group_member_list API"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "target must be group:<id>"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_forward_msg",
      "summary": "Read a merged/forwarded chat record (合并转发). Inbound events only show `[chat history: id=<id>]`; pass that id here and the record comes back as text: one `<name>: <text>` line per node, with image/face/at/record/video/file/reply segments rendered as placeholders ([图片] [表情] [@<qq>] [语音] [视频] [文件: <name>] [引用]). Each node takes the first of `content`, `message`, `raw_message` that renders non-empty.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_forward_msg"
          },
          "id": {
            "type": "string",
            "description": "forward/merged message id, e.g. the number in [chat history: id=...]"
          },
          "message_id": {
            "type": "string",
            "description": "Alternative to id (same forward id)"
          },
          "payload": {
            "type": "object",
            "properties": {
              "onebot_url": {
                "type": "string",
                "description": "Optional OneBot HTTP API URL override (defaults to STATE / runtime config)"
              },
              "access_token": {
                "type": "string",
                "description": "Optional OneBot access token override (defaults to STATE / runtime config)"
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The forward id that was read"
              },
              "text": {
                "type": "string",
                "description": "One `<name>: <text>` line per node"
              },
              "messages": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object"
                },
                "description": "Raw OneBot node array, null when the response carried none"
              }
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "calls OneBot get_forward_msg API"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "id is required",
        "OneBot API error"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_group_roles",
      "summary": "Answer 'who is the group owner / who are the admins?'. Aggregates get_group_member_list by role, and falls back to get_group_info_ex (data.extInfo.groupOwnerId.memberUin) when the member list has no role field. source tells you which path was used.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "target"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_group_roles"
          },
          "target": {
            "type": "string",
            "description": "group:<id>"
          },
          "payload": {
            "type": "object",
            "properties": {
              "onebot_url": {
                "type": "string",
                "description": "Optional OneBot HTTP API URL override (defaults to STATE / runtime config)"
              },
              "access_token": {
                "type": "string",
                "description": "Optional OneBot access token override (defaults to STATE / runtime config)"
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "owner": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "{user_id, nickname, card} or null"
              },
              "admins": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "member_count": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "source": {
                "type": "string",
                "description": "member_list | group_info_ex"
              }
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "calls OneBot get_group_member_list, then get_group_info_ex when the owner is missing"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "invalid target format",
        "OneBot API error"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_reply_policy",
      "summary": "Read the reply policy that is EFFECTIVE for a group (omit `group` to read the shared default). Returns whether the bot is allowed to speak (`enabled`: true) or must stay silent (`enabled`: false), the policy text actually shipped to the model, and where it came from (group | default | builtin).",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_reply_policy"
          },
          "group": {
            "type": "string",
            "description": "QQ group id; omit for the shared default"
          },
          "data_dir": {
            "type": "string",
            "description": "Optional data directory override"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "group": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "enabled": {
                "type": "boolean",
                "description": "false = this group is permanently silent"
              },
              "policy": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "description": "group | default | builtin"
              },
              "is_default": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "side_effects": [
        "reads data/qq_reply_policies.json"
      ],
      "failure_modes": [],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_set_reply_policy",
      "summary": "Persist the reply policy for ONE group (`group` omitted = shared default). `enabled: true` allows speaking but does not require an answer — a mention is no reason to talk; speak only when you add information or are asked. `enabled: false` (default) = permanent silence. `policy` overrides the text. Takes effect on the next message.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_set_reply_policy"
          },
          "group": {
            "type": "string",
            "description": "QQ group id; omit to change the shared default"
          },
          "enabled": {
            "type": "boolean",
            "description": "true = allowed to speak (not required to); false = permanent silence"
          },
          "mode": {
            "type": "string",
            "enum": [
              "quiet",
              "balanced",
              "chatty",
              "one_on_one"
            ],
            "description": "Legacy alias for enabled; kept for old callers"
          },
          "policy": {
            "type": "string",
            "description": "Optional free-text override (shown verbatim)"
          },
          "data_dir": {
            "type": "string",
            "description": "Optional data directory override"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "policy": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      },
      "side_effects": [
        "writes data/qq_reply_policies.json"
      ],
      "failure_modes": [
        "enabled is required",
        "unknown mode",
        "enabled must be true or false"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_group_memory",
      "summary": "Read the memo you wrote about this group: how talkative it wants you, its standing topics, what it already rejected. memory=null means you have not written anything for this group yet.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "group"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_group_memory"
          },
          "group": {
            "type": "string",
            "description": "QQ group id"
          },
          "data_dir": {
            "type": "string",
            "description": "Optional data directory override"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "memory": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "updated_at_ms": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "updated_by": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "side_effects": [
        "reads data/qq_group_memory.json"
      ],
      "failure_modes": [
        "group is required for qq_get_group_memory"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_set_group_memory",
      "summary": "Write the memo about a group, in your own words: does it want you talkative or quiet, what it talks about, what you already tried and got told off for. The memo is not injected into your context — read it with `qq_get_group_memory` when you need it. Write only what is DURABLE (not something you read from one message). Blank `memory` deletes the entry. There is no length cap.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "group"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_set_group_memory"
          },
          "group": {
            "type": "string",
            "description": "QQ group id"
          },
          "memory": {
            "type": "string",
            "description": "Memo text; empty string deletes it"
          },
          "data_dir": {
            "type": "string",
            "description": "Optional data directory override"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "memory": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      },
      "side_effects": [
        "writes data/qq_group_memory.json"
      ],
      "failure_modes": [
        "group is required for qq_set_group_memory"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_get_sent",
      "summary": "Incoming events never show what the bot itself said. Return what YOU sent to one group, oldest first: `{target, message, at_ms, msg_id}` from `data/qq_sent/<group>.jsonl`, which `qq_send` appends after every successful send. `group` is the group number (or `private-<uid>`); returns the last `limit` (default 50, max 500) or an empty list. Read-only, no network.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "group"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_get_sent"
          },
          "group": {
            "type": "string",
            "description": "QQ group id; `group:<id>` is accepted too"
          },
          "limit": {
            "type": "integer",
            "description": "How many of the most recent sends to return (default 50, max 500)"
          },
          "data_dir": {
            "type": "string",
            "description": "Optional data directory override"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "limit": {
                "type": "integer"
              },
              "count": {
                "type": "integer"
              },
              "items": {
                "type": "array",
                "description": "Oldest first",
                "items": {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "at_ms": {
                      "type": "integer"
                    },
                    "msg_id": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "side_effects": [
        "reads data/qq_sent/<group>.jsonl (no network)"
      ],
      "failure_modes": [
        "group is required for qq_get_sent",
        "limit must be a non-negative integer"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_recall",
      "summary": "撤回 bot 自己发出去的一条消息（OneBot v11 delete_msg）。`message_id` 取自消息头的 msg=<id>、qq_send 返回的 data.message_id，或 qq_get_sent 的 items[].msg_id；字符串与数字都接受。只能撤自己发的：不是自己发的、消息已不存在、或上游超时都会返回 ok=false，`error` 里是上游原文。",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "message_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "const": "qq_recall"
          },
          "message_id": {
            "type": [
              "string",
              "number"
            ],
            "description": "要撤回的消息 id（msg=<id> 整串也认）；只能是自己发的"
          },
          "payload": {
            "type": "object",
            "properties": {
              "onebot_url": {
                "type": "string",
                "description": "Optional OneBot HTTP API URL override (defaults to STATE / runtime config)"
              },
              "access_token": {
                "type": "string",
                "description": "Optional OneBot access token override (defaults to STATE / runtime config)"
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "true = OneBot 确认已撤回；false = 撤回失败（见 error）"
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "撤回了哪一条 / 哪一条没撤成"
          },
          "data": {
            "type": "object",
            "description": "成功时是 OneBot delete_msg 的原始响应，失败时是实际发出的参数 {message_id}"
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "上游原文：不是自己发的 / 消息不存在 / HTTP 超时"
          }
        }
      },
      "side_effects": [
        "calls OneBot delete_msg API"
      ],
      "failure_modes": [
        "no OneBot URL configured",
        "message_id is required for qq_recall",
        "OneBot API error (not your message / message not found)",
        "HTTP POST <url>: timeout"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "qq_system_notify",
      "summary": "Kernel notification handler — receives system messages and forwards to configured test groups. Groups whose reply policy is disabled or that are currently muted are refused; the response lists `sent` and `refused` groups.",
      "input_schema": {
        "type": "object",
        "required": [
          "node_id",
          "message"
