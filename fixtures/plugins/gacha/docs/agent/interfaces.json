{
  "plugin_id": "gacha",
  "plugin_path": "gacha",
  "plugin_version": "0.1.0",
  "abi_version": 2,
  "command_name": "Gacha",
  "nodes": [
    {
      "id": "gacha_entry",
      "summary": "原神抽卡模拟器。支持自定义UP池，完整角色库，精准保底与50/50机制。\n命令: pull [N] | status | banner | setbanner <5星> <4星> <4星> <4星> | list | reset",
      "input_schema": {
        "properties": {
          "args": {
            "description": "setbanner参数: [5星, 4星1, 4星2, 4星3]",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cmd": {
            "description": "pull | status | banner | setbanner | list | reset",
            "type": "string"
          },
          "count": {
            "description": "抽数 1-100, 默认1",
            "type": "integer"
          }
        },
        "required": [
          "cmd"
        ],
        "type": "object"
      },
      "output_schema": {
        "properties": {
          "action": {
            "type": "string"
          },
          "guaranteed": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "pity_4": {
            "type": "integer"
          },
          "pity_5": {
            "type": "integer"
          },
          "results": {
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "side_effects": [
        "accurate Genshin pity model",
        "soft pity starts at 73",
        "50/50 system",
        "custom banner support",
        "complete character roster"
      ],
      "failure_modes": [
        "invalid count",
        "unknown character name"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "gacha_status",
      "summary": "查看当前保底计数、UP池信息及抽卡统计。",
      "input_schema": {
        "properties": {
          "cmd": {
            "const": "status",
            "type": "string"
          }
        },
        "required": [
          "cmd"
        ],
        "type": "object"
      },
      "output_schema": {
        "properties": {
          "guaranteed": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "pity_4": {
            "type": "integer"
          },
          "pity_5": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "side_effects": [
        "reads current pity + banner state"
      ],
      "failure_modes": [],
      "node_type": "router",
      "agent_accessible": true
    }
  ],
  "system_hint": null
}