{
  "plugin_id": "gacha",
  "plugin_path": "gacha",
  "plugin_version": "0.1.0",
  "abi_version": 2,
  "command_name": "Gacha",
  "nodes": [
    {
      "id": "gacha_entry",
      "summary": "原神抽卡模拟器。每个玩家有自己的池子和保底（按 QQ 号区分）：默认池是当前真实卡池，玩家可以用 setbanner 换自己的 UP；操作员改的是默认池。\n命令: pull [N] | status | banner | setbanner <5星> <4星> <4星> <4星> | list | reset\n返回里的 stats.featured_4_count / off_banner_4_count 是权威的四星 UP/歪 计数——不要用角色名字去数（常驻四星池包含 UP 名字，按名字统计会重复计入）。",
      "input_schema": {
        "type": "object",
        "required": [
          "cmd"
        ],
        "properties": {
          "cmd": {
            "type": "string",
            "description": "pull | status | banner | setbanner | list | reset"
          },
          "count": {
            "type": "integer",
            "description": "抽数 1-100, 默认1"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "setbanner参数: [5星, 4星1, 4星2, 4星3]；普通玩家只改自己的池，操作员（data/qq_operators.json）改默认池"
          },
          "user": {
            "type": "string",
            "description": "仅操作员可用：指定要改的用户池；普通玩家的身份由内核注入，不能指定别人"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pity_5": {
            "type": "integer"
          },
          "pity_4": {
            "type": "integer"
          },
          "guaranteed": {
            "type": "boolean"
          }
        }
      },
      "side_effects": [
        "per-player pools and pity, keyed by QQ id",
        "default banner follows the real rate-up (setbanner by an operator)",
        "accurate Genshin pity model",
        "soft pity starts at 73",
        "50/50 system with 4-star guarantee (75% featured overall)",
        "complete character roster"
      ],
      "failure_modes": [
        "invalid count",
        "unknown character name"
      ],
      "node_type": "router",
      "agent_accessible": true
    },
    {
      "id": "gacha_status",
      "summary": "查看当前保底计数、UP池信息及抽卡统计。",
      "input_schema": {
        "type": "object",
        "required": [
          "cmd"
        ],
        "properties": {
          "cmd": {
            "type": "string",
            "const": "status"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "pity_5": {
            "type": "integer"
          },
          "pity_4": {
            "type": "integer"
          },
          "guaranteed": {
            "type": "boolean"
          }
        }
      },
      "side_effects": [
        "reads current pity + banner state"
      ],
      "failure_modes": [],
      "node_type": "router",
      "agent_accessible": true
    }
  ],
  "system_hint": null
}